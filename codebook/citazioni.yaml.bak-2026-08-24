# CODEBOOK — TIPI DI CITAZIONE
#
# COSA E' QUESTO FILE. E' lo strumento di codifica del progetto. Definisce
# le categorie, i loro confini e le regole per i casi dubbi. Vale per tutti
# i ricercatori e per tutti i mesi: NON si riscrive a ogni ricerca.
#
# PERCHE' E' UN FILE E NON UNA FRASE DETTA OGNI VOLTA. Quattro persone che
# formulano a memoria lo stesso criterio producono quattro criteri diversi.
# Non se ne accorge nessuno, perche' i risultati sembrano comunque
# plausibili — e il controllo a campione misurerebbe la variabilita' della
# formulazione invece della qualita' della codifica. Con un file versionato,
# "la stessa query" significa davvero la stessa.
#
# COME SI USA:
#     cerca --codebook codebook/citazioni.yaml --bersaglio bersagli/urgenda.yaml
#
# Il codebook (questo file) dice COME classificare. Il bersaglio dice COSA
# cercare. Il primo cambia raramente e con una revisione; il secondo cambia
# a ogni caso.
#
# STATO: BOZZA. Le categorie sotto sono una proposta da correggere sui
# passaggi reali, non da approvare in astratto. La procedura prevista e':
# si estraggono trenta passaggi difficili dal corpus, il PI li classifica,
# e da quelle decisioni si riscrivono definizioni e casi limite.

versione: 0.1-bozza
data: 2026-07-30
approvato_da: null          # va valorizzato prima dell'uso in produzione

# ── Dimensione 1: che cosa fa la citazione nel testo ─────────────────────
#
# Le categorie sono ESCLUSIVE: a ogni passaggio se ne attribuisce una sola.
# Se un passaggio sembra ricadere in due, e' un caso limite e va portato
# alla regola corrispondente in `casi_limite`.

tipo_citazione:

  - codice: menzione_in_catena
    nome: Menzione in catena
    definizione: >
      Il precedente compare in un elenco di precedenti senza che il testo
      ne tragga alcunche'. Non svolge lavoro argomentativo: toglierlo non
      cambierebbe il ragionamento.
    indizi: [ "elenco separato da punto e virgola", "'see also'", "'cfr.'", "nota a pie' di pagina senza commento" ]

  - codice: descrittiva
    nome: Descrittiva
    definizione: >
      Il testo riferisce che cosa il precedente ha deciso, senza applicarlo
      al caso presente e senza farne propria la ragione.
    indizi: [ "'the court in X held that'", "riassunto dei fatti o del dispositivo" ]

  - codice: sostanziale
    nome: Sostanziale
    definizione: >
      Il precedente e' impiegato per sostenere una proposizione che l'organo
      giudicante o la parte fa propria. E' la categoria centrale della
      ricerca.
    indizi: [ "'as held in X, ...'", "il ragionamento prosegue applicando la regola" ]

  - codice: distinguente
    nome: Distinguente
    definizione: >
      Il precedente e' richiamato per affermare che nel caso presente non
      si applica: diverso ordinamento, diversi presupposti, diverso petitum.
      Non e' un rifiuto: e' una delimitazione.
    indizi: [ "'unlike in X'", "'X is distinguishable'", "'si differenzia da'" ]

  - codice: critica
    nome: Critica
    definizione: >
      Il precedente e' richiamato per dissentire dal suo contenuto o per
      contestarne la correttezza.

  - codice: implicita
    nome: Implicita
    definizione: >
      Il ragionamento del precedente e' ripreso senza che il precedente sia
      mai nominato ne' citato. E' la categoria che nessuna ricerca testuale
      puo' produrre.
    indizi: [ "formula sostanziale corrispondente senza riferimento", "coincidenza di argomentazione" ]

# ── Dimensione 2: chi enuncia ────────────────────────────────────────────
#
# INDIPENDENTE dalla prima, e va rilevata sempre. Una citazione sostanziale
# fatta da una parte e una fatta dall'organo giudicante hanno peso
# diversissimo, e confonderle rende il dato inutilizzabile.

chi_parla:
  - codice: corte
    nome: Organo giudicante
  - codice: parte
    nome: Parte del giudizio
  - codice: interveniente
    nome: Interveniente
  - codice: amicus
    nome: Amicus curiae
  - codice: non_determinabile
    nome: Non determinabile dal passaggio

# ── Dimensione 3: annidamento ────────────────────────────────────────────

annidata:
  descrizione: >
    Vero quando l'organo che redige il documento riporta un brano di un
    altro provvedimento che a sua volta cita il bersaglio. Decisione del PI
    (30 luglio 2026): il caso va SEGNALATO, non assimilato a una citazione
    diretta.
  valori: [ "si", "no", "ambiguo" ]
  fonte_intermedia: >
    Quando identificabile, si registra il provvedimento intermedio.

# ── Casi limite ──────────────────────────────────────────────────────────
#
# Sono la parte che conta. Le categorie facili le attribuisce chiunque; il
# disaccordo fra codificatori nasce sempre qui.

# ── Dimensione 4: dove sta il riferimento ────────────────────────────────
#
# PRECOMPILATA DAL SISTEMA. Si legge dal PDF — corpo del carattere e
# posizione sulla pagina — non dal testo estratto, dove il segnale non
# sopravvive. Chi legge la corregge solo quando e' sbagliata.
#
# PERCHE' CONTA. La nota e' il luogo in cui si dichiara A CHI si attribuisce
# un principio. Un riferimento in nota e uno nel corpo non pesano uguale, e
# sommarli senza distinguerli e' un errore che non si vede piu' a valle.

posizione:
  - codice: corpo
    nome: Nel testo corrente
  - codice: nota
    nome: In nota a pie' di pagina
  - codice: non_determinabile
    nome: Il PDF non distingue i due (pagina piatta, o testo da OCR)

# ── Dimensione 5: sede del passaggio ─────────────────────────────────────
#
# PRECOMPILATA DAL SISTEMA, dal tipo di atto e dalle formule con cui una
# corte attribuisce un argomento a chi glielo ha proposto.
#
# PERCHE' CONTA. "I ricorrenti invocano Urgenda", scritto in una sentenza,
# non e' la corte che cita Urgenda: e' la corte che riassume una difesa.
# Contarli insieme gonfia proprio i casi piu' discussi — quelli che le parti
# invocano di piu' — che sono i casi su cui vogliamo dire qualcosa.

sede:
  - codice: motivazione
    nome: Ragionamento dell organo giudicante
  - codice: difese_riportate
    nome: La corte riassume l argomento di una parte
  - codice: dissenso
    nome: Opinione dissenziente
  - codice: concorrente
    nome: Opinione concorrente
  - codice: atto_di_parte
    nome: Documento depositato da una parte o da un amicus
  - codice: non_determinabile
    nome: Il documento non ha struttura processuale (lettera, relazione, avviso)

casi_limite:

  - questione: >
      Una parte cita il bersaglio e l'organo giudicante ne riporta la difesa
      riassumendola. Una riga o due?
    regola: DA DECIDERE

  - questione: >
      Il bersaglio ha piu' gradi di giudizio. Vanno distinti?
    regola: >
      NO. Decisione del PI (30 luglio 2026): chi cita il bersaglio cita il
      bersaglio, a prescindere dal grado. Non si registra il grado.

  - questione: >
      Citazione contenuta in una citazione (vedi `annidata`).
    regola: >
      Si registra come citazione del documento che la contiene, con
      `annidata = si`.

  - questione: >
      Il passaggio nomina il bersaglio solo nel titolo di un allegato o
      nell'indice del documento.
    regola: DA DECIDERE

  - questione: >
      Il documento e' interamente dedicato al bersaglio (per esempio un
      commento a quella sentenza). Ogni ripresa e' una citazione distinta?
    regola: DA DECIDERE

# ── Schema di uscita ─────────────────────────────────────────────────────
#
# Le colonne sono FISSE. Quattro persone che producono prose diverse non
# generano un dato sommabile; quattro persone che riempiono le stesse
# colonne, si'.

uscita:
  colonne:
    - case_id                 # dal front matter, non dedotto
    - case_name
    - giurisdizioni
    - document_id
    - tipo_atto               # dal front matter
    - tipo_atto_sabin         # etichetta ufficiale della fonte
    - pagina
    - citazione_testuale      # verbatim, verificabile
    - tipo_citazione          # dimensione 1
    - chi_parla               # dimensione 2
    - posizione               # dimensione 4 — precompilata
    - sede                    # dimensione 5 — precompilata
    - chi_cita_auto           # le proposte della macchina: NON si modificano
    - posizione_auto
    - sede_auto
    - dimensioni_confidenza   # alta | media | bassa
    - annidata                # dimensione 3
    - fonte_intermedia
    - proposizione_sostenuta  # a sostegno di che cosa
    - confidenza              # alta | media | bassa
    - rete                    # lessicale | semantica | entrambe
    - file                    # percorso, per riaprire
    - char_start
    - char_end
    - url_documento           # la pagina sul sito della fonte
    - codebook_versione       # quale versione di questo file ha prodotto la riga
    - indice_versione         # su quale indice

# ── Istruzioni per la lettura ────────────────────────────────────────────
#
# Sono la parte che lo strumento consegna a chi legge — persona o modello —
# insieme a ciascun passaggio.

istruzioni_lettura: |
  Ti viene mostrato un passaggio con il contesto che lo circonda e i
  metadati del documento.

  1. Stabilisci se il passaggio riguarda davvero il bersaglio. Se non lo
     riguarda, scartalo e dillo: un falso positivo scartato e' un esito
     corretto, non un fallimento.
  2. Attribuisci UNA sola categoria di `tipo_citazione`. Se ne vedi due,
     e' un caso limite: applica la regola corrispondente, e se la regola
     dice DA DECIDERE segnala il passaggio invece di scegliere.
  3. `chi_parla`, `posizione` e `sede` arrivano GIA COMPILATE dal sistema.
     Non vanno riscritte: vanno controllate, e corrette solo dove sono
     sbagliate. Le colonne che finiscono in `_auto` sono la proposta della
     macchina e non si toccano mai — servono a misurare quanto spesso il
     lettore la corregge.
  3ter. IL CAMPIONE DEL 20% DEVE COMPRENDERE ANCHE GLI SCARTI. Accanto al
     CSV c'e' un file `.SCARTI.csv` con i candidati che il sistema ha
     tolto da solo: sotto la soglia del riordinatore, anteriori alla
     decisione citata, copie di un altro frammento. Quelle righe non le
     legge nessun altro. Se il campione guardasse solo cio' che e' stato
     tenuto, non ci si accorgerebbe mai di una soglia che butta via roba
     buona: l'errore sarebbe invisibile per costruzione.
  3bis. Comincia dalle righe con `dimensioni_confidenza: bassa`: sono
     quelle in cui il sistema non ha trovato indizi e ha ripiegato.
  4. Riporta la citazione TESTUALE, senza riscriverla e senza abbreviarla.
     E' l'unico elemento che rende la riga verificabile.
  5. Indica la pagina come risulta dai metadati, non contandola.
  6. Se sei incerto, `confidenza: bassa`. Un'incertezza dichiarata e'
     utilizzabile; un'incertezza nascosta no.

  Non dedurre mai `case_id`, `tipo_atto` o `pagina`: vengono dai metadati.
